{
  "name": "budgetracker",
  "private": true,
  "packageManager": "npm@11.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages --if-present && npm run build -w apps --if-present",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true
  }
}
