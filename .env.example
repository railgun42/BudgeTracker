# Copier en .env (ignoré par git). Valeurs de DEV LOCAL uniquement, aucun secret réel.
# Les vrais secrets de prod vivent dans les variables d'environnement du serveur.

# Permet `docker compose <cmd>` sans -f en dev.
COMPOSE_FILE=docker-compose.dev.yml

POSTGRES_USER=budgetracker
POSTGRES_PASSWORD=change-me-dev
POSTGRES_DB=budgetracker
DATABASE_URL=postgresql://budgetracker:change-me-dev@localhost:5432/budgetracker

# MinIO (S3 local) — console : http://localhost:9001
MINIO_ROOT_USER=budgetracker
MINIO_ROOT_PASSWORD=change-me-dev

# Mailpit — SMTP localhost:1025, UI : http://localhost:8025

# API (apps/api) — DATABASE_URL ci-dessus est obligatoire au démarrage
PORT=3000
