// Schéma v1 (PLAN §3). Contraintes non exprimables en Prisma (CHECK, index sur
// expression) : SQL brut dans la migration initiale.
// Conventions : ids uuid générés par la BDD (utilisables en SQL brut), montants en
// centimes BigInt, jours en DATE, horodatages techniques en timestamptz (UTC).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TrackingType {
  NORMAL
  NOT_TRACKED
  WITH_INTEREST
}

enum TransactionType {
  DEBIT
  CREDIT
}

enum IntervalUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

// ADMIN : attribué uniquement par scripts/grant-admin.ts (jamais par l'API HTTP), e-mail vérifié exigé (CHECK).
enum Role {
  USER
  ADMIN
}

enum EmailTokenType {
  VERIFY
  RESET
}

// ─── Utilisateurs et authentification ───────────────────────────────────────

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Normalisé en minuscules (CHECK en migration).
  email             String    @unique
  emailVerifiedAt   DateTime? @db.Timestamptz(3)
  name              String
  lastConnection    DateTime? @db.Timestamptz(3)
  // 200 Mo par défaut ; valeur par utilisateur pour une future offre à quota élevé.
  storageQuotaBytes BigInt    @default(209715200)
  // Preuve du consentement aux CGU (date + version acceptée). Nul : comptes antérieurs à E29b.
  termsAcceptedAt   DateTime? @db.Timestamptz(3)
  termsVersion      String?
  role              Role      @default(USER)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  credential          Credential?
  oauthIdentities     OAuthIdentity[]
  emailTokens         EmailToken[]
  refreshTokens       RefreshToken[]
  accounts            Account[]
  transfers           Transfer[]
  transactions        Transaction[]
  categories          Category[]
  tags                Tag[]
  attachments         Attachment[]
  recurrences         Recurrence[]
  interestRates       InterestRate[]
  scenarios           Scenario[]
  cashflowSimulations CashflowSimulation[]
  categoryPreferences UserCategoryPreference[]
  adminAuditLogs      AdminAuditLog[]
}

// Journal des actions d'administration (SPEC §13.1) : qui, quoi, quand ; jamais de donnée financière ni d'e-mail.
// adminId NULL : action hors HTTP (script d'exploitation) ou administrateur supprimé depuis.
model AdminAuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId   String?  @db.Uuid
  action    String
  targetId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  admin User? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model Credential {
  userId       String   @id @db.Uuid
  // Argon2id ; NULL si le compte n'utilise que Google.
  passwordHash String?
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthIdentity {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  provider   String
  providerId String
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model EmailToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @db.Uuid
  type      EmailTokenType
  // Seul le hash est stocké.
  tokenHash String         @unique
  expiresAt DateTime       @db.Timestamptz(3)
  usedAt    DateTime?      @db.Timestamptz(3)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  familyId  String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

// ─── Domaine ────────────────────────────────────────────────────────────────

model Account {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String       @db.Uuid
  name         String
  trackingType TrackingType
  // EUR figé (SPEC §3.1) : colonne présente mais non exploitée.
  currency     String       @default("EUR") @db.Char(3)
  version      Int          @default(1)
  deletedAt    DateTime?    @db.Timestamptz(3)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    Transaction[]
  recurrences     Recurrence[]
  interestRates   InterestRate[]
  interestCredits InterestCredit[]

  @@index([userId, deletedAt])
}

// Porte la version et la suppression logique des deux jambes d'un virement.
model Transfer {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String          @db.Uuid
  accountId      String          @db.Uuid
  name           String
  date           DateTime        @db.Date
  // > 0 (CHECK en migration) ; le sens est porté par `type`.
  amountCents    BigInt
  type           TransactionType
  details        String?
  // Facultative (SPEC §3.2) : la plus précise des deux, sous-catégorie ou catégorie.
  categoryId     String?         @db.Uuid
  transferId     String?         @db.Uuid
  recurrenceId   String?         @db.Uuid
  occurrenceDate DateTime?       @db.Date
  // Choix explicite le jour du solde de départ (SPEC §3.3) ; NULL = pas de choix, comptée.
  countInBalance Boolean?
  version        Int             @default(1)
  deletedAt      DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  // NoAction + DEFERRABLE (migration) : une catégorie utilisée se réaffecte avant
  // suppression, mais la cascade de suppression d'un utilisateur passe.
  category       Category?        @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  transfer       Transfer?        @relation(fields: [transferId], references: [id], onDelete: Cascade)
  recurrence     Recurrence?      @relation(fields: [recurrenceId], references: [id], onDelete: SetNull)
  tags           TransactionTag[]
  attachment     Attachment?
  interestCredit InterestCredit?

  // Non partielle : une occurrence supprimée logiquement bloque sa régénération.
  @@unique([recurrenceId, occurrenceDate])
  @@index([accountId, date])
  @@index([userId, date(sort: Desc), id])
  @@index([categoryId])
  @@index([transferId])
}

// userId NULL = catégorie système (nameKey traduisible) ; sinon perso (name).
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String?  @db.Uuid
  parentId  String?  @db.Uuid
  nameKey   String?  @unique
  name      String?
  color     String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user         User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?             @relation("CategoryTree", fields: [parentId], references: [id], onDelete: NoAction)
  children     Category[]            @relation("CategoryTree")
  transactions Transaction[]
  templates    TransactionTemplate[]
  preferences  UserCategoryPreference[]

  @@index([userId])
  @@index([parentId])
}

// Masquage / renommage d'une catégorie globale pour un seul utilisateur (SPEC §3.2, §13.4).
// Ligne absente = valeurs par défaut (visible, nom d'origine).
model UserCategoryPreference {
  userId     String   @db.Uuid
  categoryId String   @db.Uuid
  hidden     Boolean  @default(false)
  customName String?
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([userId, categoryId])
  @@index([categoryId])
}

// Unicité (userId, lower(name)) : index sur expression en migration.
model Tag {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]
  templates    TemplateTag[]
}

model TransactionTag {
  transactionId String @db.Uuid
  tagId         String @db.Uuid

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
}

model Attachment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  // Unique ⇒ 0..1 pièce par transaction.
  transactionId String   @unique @db.Uuid
  // Clé générée serveur ; originalName sert à l'affichage seulement.
  s3Key         String   @unique
  originalName  String
  mime          String
  sizeBytes     Int
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Recurrence {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  accountId      String       @db.Uuid
  interval       Int
  unit           IntervalUnit
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  // Jour d'ancrage (31 ⇒ dernier jour des mois courts, sans dérive).
  anchorDay      Int
  lastGeneration DateTime?    @db.Date
  version        Int          @default(1)
  deletedAt      DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @default(now()) @updatedAt @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  template     TransactionTemplate?
  transactions Transaction[]

  @@index([userId, deletedAt])
  @@index([accountId])
}

// Lu au moment de la génération ⇒ une modification ne vaut que pour le futur.
model TransactionTemplate {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recurrenceId String          @unique @db.Uuid
  name         String
  amountCents  BigInt
  type         TransactionType
  categoryId   String?         @db.Uuid
  details      String?
  updatedAt    DateTime        @default(now()) @updatedAt @db.Timestamptz(3)

  recurrence Recurrence    @relation(fields: [recurrenceId], references: [id], onDelete: Cascade)
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  tags       TemplateTag[]

  @@index([categoryId])
}

model TemplateTag {
  templateId String @db.Uuid
  tagId      String @db.Uuid

  template TransactionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag                 @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@index([tagId])
}

model InterestRate {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @db.Uuid
  accountId     String   @db.Uuid
  // Taux annuel en points de base (300 = 3,00 %).
  rateBp        Int
  effectiveDate DateTime @db.Date
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, effectiveDate])
  @@index([userId])
}

// Idempotence du crédit d'intérêts du 31/12. Survit à la purge de sa transaction (transactionId ⇒ NULL) :
// un crédit supprimé par l'utilisateur n'est jamais recréé.
model InterestCredit {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId     String   @db.Uuid
  year          Int
  transactionId String?  @unique @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  account     Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([accountId, year])
}

model Scenario {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  name      String
  // Validé par un DTO à union discriminée (E27), jamais du JSON libre.
  params    Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Simulation de trésorerie sauvegardée (E34), relue avec les dépenses réelles.
model CashflowSimulation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  name      String
  // Validé par CashflowSimulationParamsDto à l'écriture, jamais du JSON libre.
  params    Json
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
